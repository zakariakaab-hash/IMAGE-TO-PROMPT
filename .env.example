# ==============================================================================
# Cloudflare Deployment Environment Variables
# ==============================================================================
# In production, the Cloudflare Worker uses the native `env.AI` binding directly
# to communicate with `@cf/llava-hf/llava-1.5-7b-hf`. No API token is required
# at runtime.
#
# The credentials below are deployment-level variables used only by Wrangler or
# CI/CD pipelines (e.g. GitHub Actions) to authenticate deployments to Cloudflare.
# NEVER commit real credentials to source control or expose them to the frontend.
# ==============================================================================

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
